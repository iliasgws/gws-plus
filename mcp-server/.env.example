NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Public HTTPS origin of this service, with no trailing slash.
PUBLIC_URL=https://mcp.example.org
# 32 random bytes, base64 encoded. Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Persistent path; mount a durable, access-restricted volume here.
DATABASE_PATH=/var/lib/gws-mcp/data.sqlite
BOTI_BASE_URL=https://boti.education/p/greenwood/botiapi/
BOTI_SCHOOL_NAME=Greenwood School
# Boti API client version observed in the official app (docs/api/ENDPOINT-MAP.md).
BOTI_APP_VERSION=2.4.14
BOTI_APP_VERSION_CODE=24140
BOTI_PLATFORM=android
# Optional origins allowed for browser-based MCP clients. Comma-separated exact origins.
ALLOWED_ORIGINS=
# Optional trusted reverse-proxy IPs/CIDRs used to derive the client IP for rate limits.
# Leave blank unless direct access to the service is blocked at the network layer.
TRUSTED_PROXY_CIDRS=
